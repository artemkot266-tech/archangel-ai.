<?xml version="1.0" encoding="utf-8"?>
<!-- Версия для Google Play: USE_EXACT_ALARM разрешён Google только будильникам и календарям.
     Вместо него — SCHEDULE_EXACT_ALARM, который пользователь включает сам. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:remove="android:maxSdkVersion" />
</manifest>
